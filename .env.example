# Public browser-side values only. Never put a service-role key here.
# Find both in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (legacy) or publishable key. Safe for browsers ONLY because the
# database is locked down with RLS + narrow RPC functions (see supabase/migrations).
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# Optional: cache lifetime in days (default 7)
# VITE_CACHE_TTL_DAYS=7
